generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model characters {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String             @unique @db.VarChar(100)
  color            String?            @db.VarChar(7)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  name_english     String?            @db.VarChar(100)
  manga_characters manga_characters[]

  @@index([name], map: "idx_characters_name")
  @@index([name_english], map: "idx_characters_name_english")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model creators {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String           @db.VarChar(200)
  role           String?          @db.VarChar(50)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  manga_creators manga_creators[]

  @@unique([name, role], map: "unique_creator")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model demographic {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String    @unique @db.VarChar(100)
  color        String?   @db.VarChar(7)
  description  String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  name_english String?   @db.VarChar(100)
  mangas       mangas[]

  @@index([name], map: "idx_demographic_name")
  @@index([name_english], map: "idx_demographic_name_english")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model genres {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String         @unique @db.VarChar(100)
  description  String?
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  color        String?        @db.VarChar(100)
  name_english String?        @db.VarChar(100)
  manga_genres manga_genres[]

  @@index([name], map: "idx_genres_name")
  @@index([name_english], map: "idx_genres_name_english")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model manga_characters {
  manga_id     String     @db.Uuid
  character_id String     @db.Uuid
  characters   characters @relation(fields: [character_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mangas       mangas     @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, character_id])
  @@index([character_id], map: "idx_manga_characters_character_id")
  @@index([manga_id], map: "idx_manga_characters_manga_id")
}

model manga_creators {
  manga_id   String    @db.Uuid
  creator_id String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  creators   creators  @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mangas     mangas    @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, creator_id])
}

model manga_genres {
  manga_id   String    @db.Uuid
  genre_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  genres     genres    @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mangas     mangas    @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, genre_id])
  @@index([manga_id], map: "idx_manga_genres_manga_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model manga_links {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  manga_id        String    @db.Uuid
  site_id         String?   @db.Uuid
  url             String
  label           String?   @db.VarChar(100)
  is_primary      Boolean?  @default(false)
  is_active       Boolean?  @default(true)
  last_checked_at DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  mangas          mangas    @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sites           sites?    @relation(fields: [site_id], references: [id], onUpdate: NoAction)

  @@unique([manga_id, url], map: "manga_links_manga_url_unique")
  @@index([manga_id], map: "idx_manga_links_manga_id")
  @@index([site_id], map: "idx_manga_links_site_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model manga_names {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  manga_id    String    @db.Uuid
  name        String    @db.VarChar(750)
  language    String?   @default("pt-BR") @db.VarChar(10)
  is_official Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  mangas      mangas    @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([manga_id, name], map: "unique_manga_name")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_manga_names_name_trgm", type: Gin)
}

model manga_publishers {
  manga_id         String     @db.Uuid
  publisher_id     String     @db.Uuid
  publication_date DateTime?  @db.Date
  created_at       DateTime?  @default(now()) @db.Timestamptz(6)
  mangas           mangas     @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publishers       publishers @relation(fields: [publisher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, publisher_id])
  @@index([manga_id], map: "idx_manga_publishers_manga_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model manga_tags {
  manga_id   String    @db.Uuid
