  created_at DateTime? @default(now()) @db.Timestamptz(6)
  mangas     mangas    @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, tag_id])
}

model manga_themes {
  manga_id   String    @db.Uuid
  theme_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  mangas     mangas    @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  themes     themes    @relation(fields: [theme_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, theme_id])
  @@index([manga_id], map: "idx_manga_themes_manga_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model manga_warnings {
  manga_id   String   @db.Uuid
  warning_id String   @db.Uuid
  mangas     mangas   @relation(fields: [manga_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warnings   warnings @relation(fields: [warning_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([manga_id, warning_id])
  @@index([manga_id], map: "idx_manga_warnings_manga_id")
  @@index([warning_id], map: "idx_manga_warnings_warning_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model mangas {
  id                String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  primary_title     String                 @db.VarChar(750)
  url               String?
  image_filename    String?                @db.VarChar(500)
  image_url         String?
  last_chapter_read Int?                   @default(0)
  total_chapters    Int?
  rating            Decimal?               @db.Decimal(3, 2)
  status            String?                @default("reading") @db.VarChar(50)
  synopsis          String?
  user_notes        String?
  embedding         Unsupported("vector")?
  legacy_id         Int?                   @unique
  legacy_parent_id  Int?
  created_at        DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?              @default(now()) @db.Timestamptz(6)
  last_read_at      DateTime?              @db.Timestamptz(6)
  deleted_at        DateTime?              @db.Timestamptz(6)
  status_id         String?                @db.Uuid
  type_id           String?                @db.Uuid
  rating_id         String?                @db.Uuid
  demographic_id    String?                @db.Uuid
  manga_characters  manga_characters[]
  manga_creators    manga_creators[]
  manga_genres      manga_genres[]
  manga_links       manga_links[]
  manga_names       manga_names[]
  manga_publishers  manga_publishers[]
  manga_tags        manga_tags[]
  manga_themes      manga_themes[]
  manga_warnings    manga_warnings[]
  demographic       demographic?           @relation(fields: [demographic_id], references: [id], onUpdate: NoAction)
  ratingRef         ratings?               @relation(fields: [rating_id], references: [id], onUpdate: NoAction)
  statusRef         status?                @relation(fields: [status_id], references: [id], onUpdate: NoAction)
  typeRef           types?                 @relation(fields: [type_id], references: [id], onUpdate: NoAction)
  reading_sessions    reading_sessions[]
  reminders           reminders[]
  manga_reading_lists manga_reading_lists[]

  @@index([legacy_id], map: "idx_mangas_legacy_id")
  @@index([primary_title(ops: raw("gin_trgm_ops"))], map: "idx_mangas_primary_title_trgm", type: Gin)
  @@index([synopsis(ops: raw("gin_trgm_ops"))], map: "idx_mangas_synopsis_trgm", type: Gin)
  @@index([updated_at(sort: Desc)], map: "idx_mangas_updated_at")
}

model publishers {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String             @unique @db.VarChar(200)
