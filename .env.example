# Docker Compose Environment Variables - EXEMPLO
# Copie este arquivo para .env e preencha com seus valores

# ========================================
# POSTGRES DATABASE
# ========================================
DB_NAME=manga_db
DB_USER=manga_user
DB_PASSWORD=change_this_password
DB_PORT=5432

# ========================================
# BACKEND (NestJS + Prisma) — porta 3011
# ========================================
NODE_ENV=development

# Caminho das imagens dentro do container (servidas em /images)
IMAGES_PATH=/app/storage/images

# ========================================
# FRONTEND (React + Vite) — porta 3013
# ========================================
# Lida em tempo de build/dev pelo Vite; precisa do prefixo VITE_
VITE_API_URL=http://localhost:3011/api

# ========================================
# NOTAS
# ========================================
# - Nunca commite o arquivo .env no Git
# - Use senhas fortes em produção
# - O backend monta DATABASE_URL a partir de DB_USER/DB_PASSWORD/DB_NAME
#   no docker-compose.yml; não é preciso defini-la aqui
# - VITE_API_URL é embutida no bundle em tempo de build. Para produção,
#   passe o valor como --build-arg, não em runtime
